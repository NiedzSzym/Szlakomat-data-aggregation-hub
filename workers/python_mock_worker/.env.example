# RabbitMQ — wspólne dla obu workerów
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/
TASK_EXCHANGE=orchestrator.tasks
PREFETCH_COUNT=5

