# Skopiuj do .env i dostosuj wartości

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/

TASK_EXCHANGE=orchestrator.tasks

# Unikalna nazwa kolejki per instancja workera
WORKER_QUEUE=worker.python.mock

# Routing Key pattern (Topic Exchange):
#   task.#                     → wszystkie zadania
#   task.*.attraction_wawel    → tylko Wawel, dowolny intent
#   task.pricing.*             → tylko pricing, wszystkie zasoby
BINDING_KEY=task.#

PREFETCH_COUNT=5
